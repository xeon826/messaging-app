// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Message {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  message    String
  userId     String   @map("user_id") // Add this field for the foreign key
  sender     User?    @relation("SentMessages", fields: [userId], references: [id])
  chatId     String   @map("chat_id") // Add chat relationship
  chat       Chats    @relation(fields: [chatId], references: [id])

  @@map("messages")
}

model User {
  id               String    @id
  email            String    @unique
  username         String    @unique
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  sentMessages     Message[] @relation("SentMessages")
  chats           ChatUser[]

  @@map("users")
}

model Chats {
  id        String    @id
  title     String?   // Optional title for the chat
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  users     ChatUser[]
  messages  Message[] // Add this field for the reverse relation

  @@map("chats")
}

model ChatUser {
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  chat      Chats    @relation(fields: [chatId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@id([chatId, userId])
  @@map("chat_users")
}

